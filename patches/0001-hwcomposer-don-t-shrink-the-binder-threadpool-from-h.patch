From 3b43554162258b294581e3b1786cf0b426ee0619 Mon Sep 17 00:00:00 2001
From: Hans Kramer <TheSittingPenguin96@Gmail.com>
Date: Tue, 11 Aug 2026 15:03:32 +0200
Subject: [PATCH] hwcomposer: don't shrink the binder threadpool from
 hwc_binder_thread

android.hardware.graphics.composer@2.1-service configures a 4-thread
hwbinder pool in main() and starts it before loading the HWC module.
hwc_binder_thread then called configureRpcThreadpool(1, ...), and
libhidlbase's ProcessState::setThreadPoolConfiguration aborts the
process with "Binder threadpool cannot be shrunk after starting".

Measured on a Halium 14 device (Volla Phone Plinius, mt6878): composer
and surfaceflinger crash-looped every ~5s once the EGL driver loaded
successfully, so the process reached this code for the first time.

  #03 libhidlbase.so ProcessState::setThreadPoolConfiguration(unsigned long, bool)
  #04 libhidlbase.so configureBinderRpcThreadpool(unsigned long, bool)
  #05 hwcomposer.waydroid.so hwc_binder_thread(void*)+68

This is a backport of the fix already present on dev/lineage-23.2.

Signed-off-by: Hans Kramer <TheSittingPenguin96@Gmail.com>
---
 hwcomposer/hwcomposer.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/hwcomposer/hwcomposer.cpp b/hwcomposer/hwcomposer.cpp
index f509ed7..6848518 100644
--- a/hwcomposer/hwcomposer.cpp
+++ b/hwcomposer/hwcomposer.cpp
@@ -57,7 +57,6 @@
 #include "modes/multi-window.h"
 #include "modes/single-window.h"
 
-using ::android::hardware::configureRpcThreadpool;
 using ::android::hardware::joinRpcThreadpool;
 
 using ::vendor::waydroid::display::V1_2::IWaydroidDisplay;
@@ -650,7 +649,8 @@ static void* hwc_binder_thread(void* data) {
     sp<IWaydroidClipboard> waydroidClipboard;
 
     setpriority(PRIO_PROCESS, 0, HAL_PRIORITY_URGENT_DISPLAY);
-    configureRpcThreadpool(1, true /*callerWillJoin*/);
+    // Don't configure the threadpool here: composer@2.1-service main() already
+    // set it to 4 threads, and shrinking it to 1 aborts the process.
 
     waydroidDisplay = new WaydroidDisplay(pdev->display);
     if (waydroidDisplay == nullptr) {
-- 
2.54.0

